<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>AhpAnalysisDialogBase</class>
 <widget class="QDialog" name="AhpAnalysisDialogBase">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>924</width>
    <height>650</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Analyse Multicritère Hiérarchique (AHP)</string>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="titleLabel">
     <property name="text">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=" font-size:14pt; font-weight:600;"&gt;Analyse AHP - Méthode de Saaty&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
     <property name="alignment">
      <set>Qt::AlignCenter</set>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QStackedWidget" name="stackedWidget">
     <property name="currentIndex">
      <number>0</number>
     </property>
     <widget class="QWidget" name="page0">
      <layout class="QVBoxLayout" name="page0Layout">
       <item>
        <widget class="QLabel" name="page0Title">
         <property name="text">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;
          &lt;p align="center"&gt;
          &lt;span style=" font-size:12pt; font-weight:600;"&gt;
          Bienvenue dans l'outil d'analyse AHP
          &lt;/span&gt;
          &lt;/p&gt;
          &lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignCenter</set>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupObjective">
         <property name="title">
          <string> Objectif du plugin</string>
         </property>
         <layout class="QVBoxLayout" name="groupObjectiveLayout">
          <item>
           <widget class="QLabel" name="objectiveLabel">
            <property name="text">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p align="justify"&gt;&lt;span style=" font-size:10pt;"&gt;Ce plugin permet de réaliser une analyse multicritère hiérarchique fondée sur la méthode AHP (Analytic Hierarchy Process) de Saaty. Il vise à combiner plusieurs critères géographiques sous forme de rasters pondérés afin de produire une carte d'aide à la décision.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="groupPrerequisites">
         <property name="mouseTracking">
          <bool>false</bool>
         </property>
         <property name="autoFillBackground">
          <bool>false</bool>
         </property>
         <property name="title">
          <string>Recommandations d'utilisation</string>
         </property>
         <property name="flat">
          <bool>false</bool>
         </property>
         <layout class="QVBoxLayout" name="groupPrerequisitesLayout">
          <item>
           <widget class="QLabel" name="prereqLabel">
            <property name="text">
             <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=" font-size:10pt;"&gt;Tous les rasters doivent être prétraités et normalisés (classifiés) par l'utilisateur avant l'analyse, de manière à ce que des valeurs élevées représentent toujours une situation plus favorable.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=" font-size:10pt;"&gt;Le choix &lt;/span&gt;&lt;span style=" font-size:10pt; font-style:italic;"&gt;cost / benefit&lt;/span&gt;&lt;span style=" font-size:10pt;"&gt; à l'étape 2 a donc un rôle informatif et méthodologique. Il permet de vérifier la cohérence conceptuelle des critères, mais il n'intervient pas directement dans le calcul final du raster pondéré.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=" font-size:10pt;"&gt;Afin de garantir la validité des calculs, tous les rasters associés aux critères doivent impérativement:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=" font-size:10pt;"&gt;- utiliser le même système de coordonnées (CRS),&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=" font-size:10pt;"&gt;- avoir la même résolution spatiale,&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=" font-size:10pt;"&gt;- partager la même emprise géographique,&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=" font-size:10pt;"&gt;- être déjà classifiés par l'utilisateur.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
            </property>
            <property name="wordWrap">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="page0Footer">
         <property name="text">
          <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;span style=" font-style:italic;"&gt;Cliquez sur « Suivant » pour commencer.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
         </property>
         <property name="alignment">
          <set>Qt::AlignCenter</set>
         </property>
        </widget>
       </item>
       <item>
        <spacer name="page0Spacer">
         <property name="orientation">
          <enum>Qt::Vertical</enum>
         </property>
         <property name="sizeHint" stdset="0">
          <size>
           <width>20</width>
           <height>40</height>
          </size>
         </property>
        </spacer>
       </item>
      </layout>
     </widget>
